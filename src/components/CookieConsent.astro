<aside class="rk-cookie-consent" id="rk-cookie-consent" hidden aria-live="polite" aria-label="Preferencias de cookies">
  <p>
    Utilizamos cookies analíticas de Google Analytics para medir el uso de la web y mejorarla. Solo se activarán si aceptas.
    Consulta la <a href="/politica-de-cookies/">política de cookies</a>.
  </p>
  <div class="rk-cookie-actions">
    <button type="button" class="rk-cookie-button rk-cookie-reject" data-cookie-action="rejected">Rechazar</button>
    <button type="button" class="rk-cookie-button rk-cookie-accept" data-cookie-action="accepted">Aceptar</button>
  </div>
</aside>
<div class="rk-cookie-backdrop" id="rk-cookie-backdrop" hidden aria-hidden="true"></div>

<script>
  const consentKey = 'rk_cookie_consent';
  const banner = document.getElementById('rk-cookie-consent');
  const backdrop = document.getElementById('rk-cookie-backdrop');
  const consentButtons = document.querySelectorAll<HTMLButtonElement>('[data-cookie-action]');
  const settingsButtons = document.querySelectorAll<HTMLButtonElement>('[data-cookie-settings]');

  const getConsent = () => {
    try {
      return localStorage.getItem(consentKey);
    } catch {
      return null;
    }
  };

  const setConsent = (value: string) => {
    try {
      localStorage.setItem(consentKey, value);
    } catch {}
  };

  const hideBanner = () => {
    if (!banner) return;
    banner.classList.remove('is-visible');
    document.body.classList.remove('rk-cookie-open');
    window.setTimeout(() => {
      if (!banner.classList.contains('is-visible')) banner.hidden = true;
      if (backdrop) backdrop.hidden = true;
    }, 180);
  };

  const showBanner = () => {
    if (!banner) return;
    banner.hidden = false;
    if (backdrop) backdrop.hidden = false;
    window.requestAnimationFrame(() => {
      banner.classList.add('is-visible');
      document.body.classList.add('rk-cookie-open');
    });
  };

  if (getConsent() !== 'accepted' && getConsent() !== 'rejected') showBanner();

  consentButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const choice = button.dataset.cookieAction;
      if (choice !== 'accepted' && choice !== 'rejected') return;
      setConsent(choice);
      window.dispatchEvent(new CustomEvent('rk:cookie-consent', { detail: choice }));
      hideBanner();
    });
  });

  settingsButtons.forEach((button) => button.addEventListener('click', showBanner));
</script>

<style>
  .rk-cookie-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1990;
    background: rgb(0 0 0 / .42);
  }

  .rk-cookie-consent {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(52rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 1.25rem;
    border: 1px solid light-dark(#d7dfe1, #34444b);
    border-radius: 1rem;
    background: light-dark(#ffffff, #1a252b);
    color: light-dark(#172a35, #edf3f5);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / .24);
    box-sizing: border-box;
    opacity: 0;
    transform: translateY(.75rem);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .rk-cookie-consent.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .rk-cookie-consent p {
    max-width: 62ch;
    margin: 0;
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: 1rem;
    line-height: 1.55;
  }

  .rk-cookie-consent a {
    color: light-dark(#183f50, #afd5df);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .rk-cookie-actions {
    display: flex;
    align-items: center;
    gap: .65rem;
    flex: 0 0 auto;
  }

  .rk-cookie-button {
    min-height: 2.75rem;
    padding: .65rem 1.1rem;
    border-radius: 100px;
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }

  .rk-cookie-reject {
    border: 1px solid light-dark(#183f50, #afd5df);
    background: transparent;
    color: light-dark(#183f50, #afd5df);
  }

  .rk-cookie-accept {
    border: 1px solid light-dark(#183f50, #afd5df);
    background: light-dark(#183f50, #afd5df);
    color: light-dark(#f7fbfc, #142832);
  }

  .rk-cookie-button:focus-visible,
  .rk-cookie-consent a:focus-visible {
    outline: 2px solid light-dark(#183f50, #d8f1f7);
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .rk-cookie-consent {
      right: .75rem;
      bottom: .75rem;
      left: .75rem;
      align-items: stretch;
      flex-direction: column;
      gap: 1rem;
      width: calc(100% - 1.5rem);
      max-height: calc(100dvh - 1.5rem);
      padding: 1rem;
      overflow-y: auto;
    }

    .rk-cookie-actions {
      width: 100%;
    }

    .rk-cookie-button {
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rk-cookie-consent {
      transition: none;
    }
  }
</style>
