---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Rediseño de webs creadas con el Kit Digital | Premiero',
	description = 'Servicio privado de Premiero para rediseñar y mejorar en WordPress webs creadas mediante el Kit Digital. Independiente de Red.es y de los organismos gestores del programa.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = new URL('/', Astro.site);
const logoURL = new URL('/premiero-logo.png', Astro.site);
const isHome = Astro.url.pathname === '/';
const websiteId = new URL('/#website', Astro.site).href;
const organizationId = new URL('/#organization', Astro.site).href;
const webpageId = new URL(`${Astro.url.pathname}#webpage`, Astro.site).href;
const serviceId = new URL('/#service', Astro.site).href;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': organizationId,
			name: 'Premiero',
			legalName: 'ESSENTIAL HAPPYNESS, S.L.',
			taxID: 'B88342258',
			url: 'https://www.premiero.es/',
			logo: logoURL.href,
			email: 'hola@premiero.es',
		},
		{
			'@type': 'WebSite',
			'@id': websiteId,
			url: siteURL.href,
			name: 'Arreglar web Kit Digital',
			inLanguage: 'es',
			publisher: { '@id': organizationId },
		},
		{
			'@type': 'WebPage',
			'@id': webpageId,
			url: canonicalURL.href,
			name: title,
			description,
			inLanguage: 'es',
			isPartOf: { '@id': websiteId },
			...(isHome ? { about: { '@id': serviceId } } : {}),
		},
		...(isHome ? [{
			'@type': 'Service',
			'@id': serviceId,
			name: 'Rediseño de webs creadas con el Kit Digital',
			description: 'Servicio privado de rediseño y mejora en WordPress para empresas que no están satisfechas con su web actual.',
			url: canonicalURL.href,
			provider: { '@id': organizationId },
			isRelatedTo: { '@id': websiteId },
		}] : []),
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem('rk-theme');
				if (savedTheme === 'light' || savedTheme === 'dark') {
					document.documentElement.dataset.theme = savedTheme;
				}
			} catch {}
		</script>
		<script is:inline>
			(() => {
				const consentKey = 'rk_cookie_consent';
				const analyticsId = 'G-K2X4SM7DZ1';
				let analyticsLoaded = false;
				window[`ga-disable-${analyticsId}`] = true;

				const loadAnalytics = () => {
					if (analyticsLoaded) return;
					analyticsLoaded = true;
					window[`ga-disable-${analyticsId}`] = false;
					window.dataLayer = window.dataLayer || [];
					window.gtag = function gtag(){window.dataLayer.push(arguments);};
					window.gtag('js', new Date());
					window.gtag('config', analyticsId);

					const script = document.createElement('script');
					script.async = true;
					script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
					document.head.appendChild(script);
				};

				try {
					if (localStorage.getItem(consentKey) === 'accepted') loadAnalytics();
				} catch {}

				window.addEventListener('rk:cookie-consent', (event) => {
					if (event.detail === 'accepted') loadAnalytics();
					if (event.detail === 'rejected') window[`ga-disable-${analyticsId}`] = true;
				});
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Arreglar web Kit Digital" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={logoURL} />
		<meta property="og:image:alt" content="Símbolo de Premiero" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={logoURL} />
		<meta name="theme-color" content="#f5f4ef" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#11191e" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="light dark" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap.xml" />
		<link rel="icon" type="image/png" href="/premiero-logo.png" />
		<link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<WhatsAppWidget />
		<CookieConsent />
	</body>
</html>
