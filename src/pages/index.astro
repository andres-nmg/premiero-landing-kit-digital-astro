---
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';

const cf7FormId = '15169';
const cf7FeedbackEndpoint = `https://www.premiero.es/cms/wp-json/contact-form-7/v1/contact-forms/${cf7FormId}/feedback`;
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '6Ld2G_AsAAAAAEHBN70hr2pGU3T0_QKHdTQJ3wzm';
---

<Layout>
<div id="rescate-kit-v2">
  <SiteHeader />

  <main>
    <section class="rk-hero rk-shell" id="rk-home">
      <div>
        <p class="rk-kicker">Rediseño de webs creadas con el Kit Digital</p>
        <h1><span class="rk-hero-title-first">Te hicieron una web.</span><br><em>El problema es que no te sirve.</em></h1>
        <p class="rk-lead">En Premiero ofrecemos un <strong>servicio profesional de rediseño en WordPress</strong> para empresas que no están satisfechas con la web que recibieron. Trabajamos el diseño, los contenidos y la parte técnica para que represente mejor al negocio y sea más fácil de gestionar.</p>
        <div class="rk-actions"><a class="rk-button rk-button-primary" href="#rk-contacto"><Icon name="scan-search" /> Solicitar auditoría gratuita</a><a class="rk-button" href="https://wa.me/34684774365?text=Hola%2C%20quiero%20solicitar%20informaci%C3%B3n%20para%20arreglar%20la%20web%20de%20mi%20Kit%20Digital." target="_blank" rel="noopener noreferrer"><Icon name="message-circle" /> Hablar por WhatsApp</a></div>
        <ul class="rk-hero-checks">
          <li><Icon name="check-circle-2" /> Servicio privado de rediseño web</li>
          <li><Icon name="check-circle-2" /> Auditoría inicial gratuita y sin compromiso</li>
          <li><Icon name="check-circle-2" /> No tramitamos ayudas del Kit Digital</li>
        </ul>
      </div>
      <div class="rk-hero-compare" aria-label="Comparación conceptual de rediseño">
        <div class="rk-hero-compare-head"><span>La diferencia se ve.</span><div class="rk-toggle" aria-label="Cambiar vista"><button type="button" data-rk-view="before" aria-pressed="false">Antes</button><button type="button" data-rk-view="after" aria-pressed="true">Después</button></div></div>
        <div class="rk-browser"><div class="rk-browserbar"><span class="rk-browser-dots" aria-hidden="true"><b></b><b></b><b></b></span>Brava · Carpintería</div>
          <div class="rk-after-site" data-rk-panel="after"><div class="rk-after-copy"><div class="rk-after-nav"><strong class="rk-after-logo">brava.</strong><span>Cocinas · Armarios · Mobiliario</span></div><div class="rk-after-label">Carpintería a medida en Madrid</div><div class="rk-after-title">Tu casa no salió de una plantilla.</div><p>Diseñamos y fabricamos espacios que encajan contigo, de la primera idea al último detalle.</p><span class="rk-after-cta">Cuéntanos tu proyecto ↗</span></div><div class="rk-after-visual"><div class="rk-wood-arch"></div><span class="rk-visual-note">Diseño conceptual</span></div></div>
          <div class="rk-before-site" data-rk-panel="before" hidden><div class="rk-before-nav"><strong>Carpintería Brava</strong><span>Inicio | Servicios | Contacto</span></div><div class="rk-stock">Imagen de stock genérica</div><h3>Bienvenido a nuestra página web</h3><p>Somos una empresa líder en el sector con amplia experiencia. Ofrecemos servicios de calidad y atención personalizada para todo tipo de clientes.</p><span class="rk-before-button">Más información</span></div>
        </div>
        <div class="rk-compare-note"><span class="rk-compare-caption" data-rk-caption aria-live="polite">Mensaje propio, personalidad y una acción clara.</span><span>Ejemplo ficticio · comparación conceptual</span></div>
      </div>
    </section>

    <div class="rk-proof rk-shell"><span><Icon name="key-round" /> Tus accesos</span><span><Icon name="gauge" /> Carga rápida</span><span><Icon name="mouse-pointer-click" /> Pensada para convertir</span><span><Icon name="badge-euro" /> Presupuesto cerrado</span></div>

    <section class="rk-section rk-shell" id="rk-problemas">
      <div class="rk-section-head"><div><p class="rk-eyebrow">El espejo</p><h2>Si esto te suena,<br>no eres el único.</h2></div><p class="rk-section-intro">El problema no es que “no te guste” la web. El problema es que no representa tu negocio, no genera confianza y no te trae oportunidades.</p></div>
      <div class="rk-mirror">
        <article class="rk-pain"><div class="rk-pain-top"><span class="rk-pain-index">01 / Diseño genérico</span><Icon name="copy" /></div><div><h3>Parece la web de cualquiera.</h3><p>La web se apoya en una plantilla genérica, imágenes de stock y textos poco específicos. Tu negocio tiene personalidad; tu web también debería reflejarla.</p></div></article>
        <article class="rk-pain"><div class="rk-pain-top"><span class="rk-pain-index">02 / Falta de accesos</span><Icon name="lock-keyhole" /></div><div><h3>No tienes los accesos de tu web.</h3><p>Puede que no tengas claro quién gestiona WordPress, el alojamiento o el dominio. Antes de diseñar, revisamos la situación y te orientamos sobre las opciones disponibles.</p></div></article>
        <article class="rk-pain"><div class="rk-pain-top"><span class="rk-pain-index">03 / Rendimiento y contacto</span><Icon name="snail" /></div><div><h3>Está publicada, pero no te ayuda.</h3><p>Puede tardar en cargar, resultar difícil de encontrar o no facilitar el contacto. La reconstruimos para explicar mejor el servicio y ofrecer un recorrido claro hasta el formulario.</p></div></article>
        <article class="rk-pain"><div class="rk-pain-top"><span class="rk-pain-index">04 / Falta de soporte</span><Icon name="unplug" /></div><div><h3>No recibes el soporte que necesitas.</h3><p>La web quedó publicada, pero ahora no sabes a quién acudir para resolver cambios o incidencias. Con Premiero tendrás trato directo, expectativas claras y acompañamiento profesional.</p></div></article>
      </div>
    </section>

    <section class="rk-section rk-shell rk-rescue" id="rk-rescate">
      <div class="rk-rescue-intro"><p class="rk-eyebrow">El rescate</p><h2>Revisar.<br>Rediseñar.<br>Ponerla bajo tu control.</h2><p>Revisamos el estado actual de la web, ordenamos la parte técnica y construimos una página que tenga sentido para tu negocio.</p></div>
      <div class="rk-steps"><article class="rk-step"><span class="rk-step-number">01</span><div><h3>Revisamos tus accesos y la situación del dominio.</h3><p>Identificamos quién gestiona WordPress, el alojamiento y el dominio, y te orientamos sobre las opciones disponibles cuando falta algún acceso.</p></div></article><article class="rk-step"><span class="rk-step-number">02</span><div><h3>Rediseñamos la web en WordPress.</h3><p>Una web rápida, moderna, fácil de actualizar y enfocada en que una visita entienda qué haces, confíe en ti y contacte.</p></div></article><article class="rk-step"><span class="rk-step-number">03</span><div><h3>Te entregamos la nueva web y sus accesos.</h3><p>Al finalizar el proyecto, recibes la web y los accesos que gestiona Premiero. El mantenimiento posterior es opcional y se contrata por separado.</p></div></article></div>
    </section>

    <aside class="rk-filter"><div><p class="rk-filter-mark"><Icon name="circle-alert" /> Esto conviene dejarlo claro</p><h2>Es un servicio privado de rediseño web.</h2></div><p class="rk-filter-copy">Es un <strong>servicio profesional de pago prestado por Premiero</strong>. No tramitamos ayudas ni actuamos en nombre de Red.es o de los organismos gestores del programa Kit Digital.</p></aside>

    <section class="rk-section rk-shell rk-faq"><div><p class="rk-eyebrow">Preguntas frecuentes</p><h2>Lo que seguramente te estás preguntando.</h2></div><div class="rk-faq-list"><details name="rk-faq"><summary>¿Qué pasa si no tengo las contraseñas ni el acceso a mi web o dominio?</summary><p>Primero identificamos quién gestiona cada acceso y te orientamos para solicitarlo. Si existe algún bloqueo, conocerás las opciones disponibles antes de contratar el rediseño.</p></details><details name="rk-faq"><summary>¿Puedo rediseñar la web que me hicieron con el Kit Digital?</summary><p>Sí, es posible rediseñarla, pero antes de sustituir la web actual hay que confirmar que ha terminado el periodo de prestación del servicio subvencionado y qué obligaciones siguen pendientes. No basta con contar un año desde que te concedieron la ayuda.</p><p>También conviene comprobar quién gestiona el dominio, el alojamiento y las licencias, y si tu contrato contempla renovaciones o permanencias. Con esa información y los accesos disponibles, en Premiero podremos concretar cómo realizar el cambio.</p></details><details name="rk-faq"><summary>¿Seré el dueño real de la web o me atáis a una cuota mensual?</summary><p>Serás el titular de la web y tendrás sus accesos. Si después quieres mantenimiento, será un servicio opcional y separado, no una condición para conservar tu página.</p></details><details name="rk-faq"><summary>¿Cuánto cuesta rediseñar mi web?</summary><p>El precio se calcula para cada proyecto, según el estado de tu web, el número de páginas y las funcionalidades que necesites. La auditoría inicial es gratuita y nos permite proponerte una solución ajustada a tu negocio y a tus prioridades. Antes de empezar, recibirás un presupuesto con el alcance y el precio definidos.</p></details></div></section>

    <section class="rk-section rk-shell rk-authority" id="rk-premiero" aria-labelledby="rk-premiero-title">
      <div class="rk-section-head">
        <div><p class="rk-eyebrow">Un servicio de Premiero</p><h2 id="rk-premiero-title">Detrás de tu nueva web hay<br class="rk-desktop-break"> personas, no otra plantilla.</h2></div>
        <div class="rk-section-intro"><p>Somos Andrés y Belén, el equipo de Premiero. Unimos desarrollo web y diseño gráfico para crear páginas que respondan a las necesidades de cada negocio.</p><p class="rk-authority-paragraph">Este servicio nace de una idea sencilla: que una mala primera experiencia no te obligue a conformarte con una web que no te representa.</p><a class="rk-authority-link" href="https://www.premiero.es/" target="_blank" rel="noopener noreferrer">Conoce al equipo y nuestro trabajo en <span>Premiero ↗</span></a></div>
      </div>
    </section>

    <section class="rk-contact rk-shell" id="rk-contacto"><div><p class="rk-eyebrow">Primer paso: revisar lo que tienes</p><h2>Déjanos tu web y te diremos por dónde empezar.</h2><p class="rk-contact-copy">Haremos una primera revisión gratuita para señalarte qué está fallando y qué cambios tendrían más impacto. Una valoración personal, clara y sin compromiso.</p></div><form class="rk-form" method="post" action={cf7FeedbackEndpoint} data-cf7-endpoint={cf7FeedbackEndpoint} data-recaptcha-site-key={recaptchaSiteKey}><input type="hidden" name="_wpcf7" value={cf7FormId}><input type="hidden" name="_wpcf7_version" value="6.1"><input type="hidden" name="_wpcf7_locale" value="es_ES"><input type="hidden" name="_wpcf7_unit_tag" value={`wpcf7-f${cf7FormId}-p0-o1`}><input type="hidden" name="_wpcf7_container_post" value="0"><input type="hidden" name="_wpcf7_posted_data_hash" value=""><input type="hidden" name="_wpcf7_recaptcha_response" value=""><input type="hidden" name="g-recaptcha-response" value=""><label class="rk-field">Nombre<input type="text" name="nombre" placeholder="¿Cómo te llamas?" autocomplete="name" required></label><label class="rk-field">Teléfono / WhatsApp<input type="tel" name="telefono" placeholder="600 000 000" autocomplete="tel" inputmode="tel" required></label><label class="rk-field">Email<input type="email" name="email" placeholder="tu@empresa.es" autocomplete="email" required></label><label class="rk-field">Web actual<input type="text" name="web" placeholder="tuempresa.es" autocomplete="url" inputmode="url" autocapitalize="none" spellcheck="false" required></label><label class="rk-consent rk-form-wide"><input type="checkbox" name="aceptacion_privacidad" value="1" required><span>He leído la <a href="/politica-de-privacidad/">política de privacidad</a> y consiento que Premiero utilice mis datos para atender mi solicitud y contactarme al respecto.</span></label><button class="rk-submit rk-form-wide" type="submit">Quiero una revisión gratuita <Icon name="arrow-right" /></button><div class="rk-feedback" aria-live="polite"></div><p class="rk-recaptcha-notice rk-form-wide" hidden>Este sitio está protegido por reCAPTCHA y se aplican la <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Política de Privacidad</a> y los <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">Términos del Servicio</a> de Google.</p></form></section>
  </main>

  <SiteFooter />
</div>


</Layout>

<script>
  const root = document.querySelector<HTMLElement>('#rescate-kit-v2');

  if (root) {
    const toggles = root.querySelectorAll<HTMLButtonElement>('[data-rk-view]');
    const panels = root.querySelectorAll<HTMLElement>('[data-rk-panel]');
    const caption = root.querySelector<HTMLElement>('[data-rk-caption]');

    toggles.forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.rkView;
        toggles.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.rkPanel !== view;
        });
        if (caption) {
          caption.textContent = view === 'after'
            ? 'Mensaje propio, personalidad y una acción clara.'
            : 'Una plantilla que podría pertenecer a cualquier negocio.';
        }
      });
    });

    const form = root.querySelector<HTMLFormElement>('.rk-form');
    const feedback = root.querySelector<HTMLElement>('.rk-feedback');
    const submitButton = form?.querySelector<HTMLButtonElement>('.rk-submit');
    const recaptchaNotice = form?.querySelector<HTMLElement>('.rk-recaptcha-notice');

    if (form && feedback && submitButton) {
      const recaptchaKey = form.dataset.recaptchaSiteKey || '';
      const originalButtonContent = submitButton.innerHTML;
      let recaptchaLoader: Promise<void> | null = null;

      const loadRecaptcha = async () => {
        if (!recaptchaKey || (window as any).grecaptcha) return;
        if (!recaptchaLoader) {
          recaptchaLoader = new Promise<void>((resolve, reject) => {
            const script = document.createElement('script');
            script.src = `https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(recaptchaKey)}`;
            script.async = true;
            script.defer = true;
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('recaptcha_load_failed'));
            document.head.appendChild(script);
          }).catch((error) => {
            recaptchaLoader = null;
            throw error;
          });
        }
        await recaptchaLoader;
      };

      if (recaptchaKey) {
        const preloadRecaptcha = () => loadRecaptcha().catch(() => {});
        form.addEventListener('focusin', preloadRecaptcha, { once: true });
        form.addEventListener('pointerdown', preloadRecaptcha, { once: true, passive: true });
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (recaptchaKey) {
          recaptchaNotice?.removeAttribute('hidden');
        }

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        submitButton.disabled = true;
        submitButton.textContent = 'Enviando…';
        feedback.classList.remove('is-error');
        feedback.textContent = '';

        try {
          const formData = new FormData(form);
          const submittedWebsite = String(formData.get('web') || '').trim();
          if (submittedWebsite) {
            const normalizedWebsite = /^https?:\/\//i.test(submittedWebsite)
              ? submittedWebsite
              : `https://${submittedWebsite}`;
            formData.set('web', normalizedWebsite);
          }

          if (recaptchaKey) {
            await loadRecaptcha();
            const grecaptcha = (window as any).grecaptcha;
            if (!grecaptcha) throw new Error('recaptcha_unavailable');

            const token = await new Promise<string>((resolve, reject) => {
              grecaptcha.ready(() => {
                grecaptcha.execute(recaptchaKey, { action: 'contact' }).then(resolve).catch(reject);
              });
            });

            formData.set('_wpcf7_recaptcha_response', token);
            formData.set('g-recaptcha-response', token);
          }

          const endpoint = form.dataset.cf7Endpoint || form.action;
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const data = await response.json().catch(() => null);

          if (!response.ok) throw new Error('request_failed');

          if (data?.status === 'mail_sent') {
            feedback.textContent = data.message || 'Solicitud enviada correctamente. Te responderemos lo antes posible.';
            form.reset();
          } else if (data?.status === 'spam') {
            feedback.classList.add('is-error');
            feedback.textContent = 'El control antispam ha rechazado el envío. Inténtalo de nuevo o contacta con nosotros por WhatsApp.';
          } else if (data?.status === 'mail_failed') {
            feedback.classList.add('is-error');
            feedback.textContent = 'WordPress ha recibido la solicitud, pero no ha podido enviar el correo. Contacta con nosotros por WhatsApp mientras lo solucionamos.';
          } else if (['validation_failed', 'unaccepted', 'aborted'].includes(data?.status)) {
            feedback.classList.add('is-error');
            feedback.textContent = data?.message || 'No hemos podido enviar la solicitud. Revisa los campos e inténtalo de nuevo.';
          } else {
            throw new Error('unexpected_response');
          }
        } catch {
          feedback.classList.add('is-error');
          feedback.textContent = 'No hemos podido enviar la solicitud. Inténtalo de nuevo o contacta con nosotros por WhatsApp.';
        } finally {
          submitButton.disabled = false;
          submitButton.innerHTML = originalButtonContent;
        }
      });
    }
  }
</script>
